DEPTH = 16384;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT
BEGIN
00000000 : 100101b7;   % 5:     li gp,0x10010000  %
00000001 : 00018193;   % 5:  %
00000002 : 00500313;   % 8:     li   t1, 5 %
00000003 : 00a00293;   % 9:     li   t0, 10 %
00000004 : 006282b3;   % 10:     add  t0, t0, t1       # t0 = t0 + 5 = 15 %
00000005 : 00528293;   % 13:     addi t0, t0, 5        # t0 = t0 + 5 = 20 %
00000006 : 00a00313;   % 17:     addi t1, x0, 10      %
00000007 : 406282b3;   % 18:     sub t0, t0, t1        # t0 = t0 - 10 = 10 %
00000008 : 00c00313;   % 21:     li t1, 0xC            # t1 = 12 %
00000009 : 00a00393;   % 22:     li t2, 0xA            # t2 = 10 %
0000000a : 007372b3;   % 23:     and t0, t1, t2        # t0 = 12 AND 10 = 8 %
0000000b : 007362b3;   % 26:     or t0, t1, t2         # t0 = 12 OR 10 = 14 %
0000000c : 00a00313;   % 29:     li t1, 10             # t1 = 10 %
0000000d : 01400393;   % 30:     li t2, 20             # t2 = 20 %
0000000e : 007322b3;   % 31:     slt t0, t1, t2        # t0 = (10 < 20) = 1 %
0000000f : 0063a2b3;   % 32:     slt t0, t2, t1        # t0 = (20 < 10) = 0 %
00000010 : 0fc10317;   % 36:     la t1, result_sw %
00000011 : fc030313;   % 36:  %
00000012 : 00532023;   % 37:     sw t0, 0(t1) %
00000013 : 00032283;   % 38:     lw t0, 0(t1) %
00000014 : 00528463;   % 42:     beq t0, t0, label_beq_true %
00000015 : 06300293;   % 43:     addi t0, x0, 99       # NÃO executa esse (comprovação) %
00000016 : 00100293;   % 45:     addi t0, x0, 1        # t0 = 1 (se o beq funcionou) %
00000017 : 00c000ef;   % 48:     jal ra, sub_rotina %
00000018 : 03200293;   % 49:     addi t0, x0, 50       # t0 = 50 (para mostrar que retornou) %
00000019 : 0200006f;   % 50:     j end_program       %
0000001a : 06400293;   % 53:     addi t0, x0, 100      # t0 = 100 (apenas para mostrar que entrou na sub-rotina) %
0000001b : 00008067;   % 54:     jr ra                 # Retorna %
0000001c : 00000317;   % 57:     la t1, end_program %
0000001d : 01430313;   % 57:  %
0000001e : 00030313;   % 58:     addi t1, t1, 0 %
0000001f : 00030067;   % 59:     jalr x0, t1, 0 %
00000020 : 3e700293;   % 60:     addi t0, x0, 999      # NÃO executa esse %
00000021 : 0000006f;   % 63:     j end_program         # Loop infinito %
END;
